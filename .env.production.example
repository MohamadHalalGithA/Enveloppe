# Copy to .env.production ON THE SERVER only (never commit it). Used by docker-compose.prod.yml.

# Public hostname Caddy serves (a domain pointed at the VM, or <ip-with-dashes>.sslip.io)
DOMAIN=
# Must be https://$DOMAIN — Auth0 callbacks and the API's same-origin check use it
APP_BASE_URL=

# Database password for the bundled Postgres (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# HMAC key for reference numbers (32+ random bytes, hex). Keep it stable: changing it breaks case matching.
REF_HMAC_KEY=

# Gemini (paid tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Auth0 — production application (its Allowed Callback URL must be https://$DOMAIN/auth/callback)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32+ random bytes, hex; different from development
AUTH0_SECRET=

# ElevenLabs (key restricted to text-to-speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# off in normal use; "fallback" during a demo (saved readings of the sample files if Gemini fails)
DEMO_MODE=off
