{
  "name": "enveloppe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "demo:letters": "tsx demo/letters/render.ts",
    "extract": "tsx --conditions=react-server scripts/extract-letter.ts",
    "test:live": "vitest run --mode live"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.30.0",
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.24.0",
    "drizzle-orm": "^0.45.3",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.14",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tldts": "^7.4.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
