# Copy to .env.local and fill in. Never commit real values. Never prefix secrets with NEXT_PUBLIC_.

APP_BASE_URL=http://localhost:3000

# Database. Local dev: PGlite (real Postgres in-process, no Docker) stored under ./.data (gitignored).
# With Docker instead: postgres://enveloppe:enveloppe@localhost:5432/enveloppe (npm run db:up). Production: a real Postgres URL.
DATABASE_URL=pglite:./.data/enveloppe

# HMAC key for reference numbers (32+ random bytes, hex). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REF_HMAC_KEY=

# Gemini (paid tier key; free-tier data may be used for product improvement)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Auth0 (@auth0/nextjs-auth0 v4). AUTH0_SECRET: 32+ random bytes, hex.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Demo only: enables the "Use cached reading" fallback for the demo account
DEMO_MODE=false
